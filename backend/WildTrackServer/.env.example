# Supabase Configuration
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key  # For admin operations only

# Auth0 Configuration
# Get these from your Auth0 Dashboard
AUTH0_DOMAIN=your-app.us.auth0.com  # From Auth0 Dashboard -> Settings -> Domain
AUTH0_API_AUDIENCE=https://your-api-identifier  # From Auth0 Dashboard -> APIs -> Your API -> Identifier
AUTH0_CLIENT_ID=optional-client-id  # Optional: For Auth0 management operations
AUTH0_CLIENT_SECRET=optional-client-secret  # Optional: For Auth0 management operations


GEMINI_API_KEY=GeminiAPIKey

# Optional: Direct database connection (if needed)
# DB_HOST=db.your-project-id.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-db-password
